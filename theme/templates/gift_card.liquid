{% layout none %}
{%- comment -%}
  Gift card (ARCHITECTURE §2.5): standalone page. Code, balance, expiry, QR code, Apple Wallet,
  print. Shows only what Shopify provides; nothing is invented.
{%- endcomment -%}
<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    {%- render 'sf-head-boot' -%}
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="robots" content="noindex">
    <meta name="theme-color" content="{{ settings.color_ink | default: '#000000' }}">
    <title>{{ 'gift_card.title' | t }} – {{ shop.name }}</title>
    {%- render 'sf-css-tokens' -%}
    {{ 'sf-base.css' | asset_url | stylesheet_tag }}
    {{ 'sf-gift-card.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'vendor/qrcode.js' | shopify_asset_url }}" defer></script>
    {{ content_for_header }}
  </head>
  <body class="sf-body sf-gift-card-page">
    <main id="MainContent" class="sf-gift-card" aria-labelledby="sf-gift-card-title">
      <header class="sf-gift-card__header">
        <a class="sf-gift-card__logo" href="{{ shop.url }}" aria-label="{{ shop.name | escape }}">
          {%- render 'sf-logo', variant: 'flat', width: 148, alt: shop.name -%}
        </a>
      </header>
      <section class="sf-gift-card__card">
        <h1 class="sf-gift-card__title sf-micro" id="sf-gift-card-title">{{ 'gift_card.title' | t }}</h1>
        {%- assign balance = gift_card.balance | money -%}
        <p class="sf-gift-card__balance sf-display-lg sf-tabular"><span class="sf-visually-hidden">{{ 'gift_card.value' | t }}: </span>{{ balance }}</p>
        {%- if gift_card.balance != gift_card.initial_value -%}
          {%- assign initial = gift_card.initial_value | money -%}
          <p class="sf-gift-card__meta">{{ 'gift_card.initial_value' | t: value: initial }}</p>
        {%- endif -%}
        {%- if gift_card.expired -%}
          <p class="sf-gift-card__status" role="status">{{ 'gift_card.expired' | t }}</p>
        {%- elsif gift_card.enabled == false -%}
          <p class="sf-gift-card__status" role="status">{{ 'gift_card.disabled' | t }}</p>
        {%- elsif gift_card.expires_on -%}
          {%- assign expires = gift_card.expires_on | date: '%B %-d, %Y' -%}
          <p class="sf-gift-card__meta">{{ 'gift_card.expires_on' | t: expires_on: expires }}</p>
        {%- endif -%}

        <div class="sf-gift-card__code-row">
          <label class="sf-field__label" for="sf-gift-card-code">{{ 'gift_card.code' | t }}</label>
          <div class="sf-gift-card__code">
            <input class="sf-input sf-tabular" id="sf-gift-card-code" type="text" value="{{ gift_card.code | escape }}" readonly>
            <button type="button" class="sf-btn sf-btn--secondary" data-sf-copy-code hidden><span class="sf-btn__label">{{ 'gift_card.copy' | t }}</span></button>
          </div>
          <p class="sf-gift-card__copied" role="status" data-sf-copy-status></p>
        </div>

        <div class="sf-gift-card__qr" id="sf-gift-card-qr" data-identifier="{{ gift_card.qr_identifier | escape }}" role="img" aria-label="{{ 'gift_card.qr' | t | escape }}"></div>

        <div class="sf-gift-card__actions">
          {%- if gift_card.pass_url -%}
            <a class="sf-btn sf-btn--secondary" href="{{ gift_card.pass_url }}"><span class="sf-btn__label">{{ 'gift_card.apple_wallet' | t }}</span></a>
          {%- endif -%}
          <button type="button" class="sf-btn sf-btn--text" data-sf-print hidden><span class="sf-btn__label">{{ 'gift_card.print' | t }}</span></button>
          <a class="sf-btn sf-btn--primary" href="{{ shop.url }}"><span class="sf-btn__label">{{ 'gift_card.shop' | t }}</span></a>
        </div>
      </section>
    </main>
    <script>
      document.addEventListener('DOMContentLoaded', function () {
        var qr = document.getElementById('sf-gift-card-qr');
        try {
          if (qr && window.QRCode) new window.QRCode(qr, { text: qr.getAttribute('data-identifier'), width: 128, height: 128, colorDark: '#000000', colorLight: '#F1E9DA' });
        } catch (e) {}
        var copy = document.querySelector('[data-sf-copy-code]');
        var status = document.querySelector('[data-sf-copy-status]');
        if (copy && navigator.clipboard) {
          copy.hidden = false;
          copy.addEventListener('click', function () {
            navigator.clipboard.writeText(document.getElementById('sf-gift-card-code').value).then(function () {
              status.textContent = {{ 'gift_card.copied' | t | json }};
            });
          });
        }
        var print = document.querySelector('[data-sf-print]');
        if (print) { print.hidden = false; print.addEventListener('click', function () { window.print(); }); }
      });
    </script>
  </body>
</html>

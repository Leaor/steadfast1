{%- doc -%}
  Responsive image (ARCHITECTURE §1.3). Renders a Shopify image/media with image_url + image_tag,
  or, when `image` is blank, a bundled theme asset as <picture> (WebP srcset + one fallback) using
  the generated record from sf-asset-data. Unknown or missing both → a neutral placeholder SVG.

  @param {object} [image] - Shopify image or media object.
  @param {string} [asset] - Bundled asset base name (ARCHITECTURE §10.1), e.g. 'sf-category-hoodies'.
  @param {string} sizes - The sizes attribute.
  @param {string} [class] - Extra classes on the <img>.
  @param {string} [alt] - Alt text. Defaults to image.alt / the asset's default alt. Pass '' for decorative images.
  @param {string} [loading] - 'lazy' (default) or 'eager'.
  @param {string} [fetchpriority] - 'high' for the LCP image.
  @param {string} [widths] - CSV of widths for Shopify images. Default '360,540,720,960,1200,1440,1800,2200'.
  @param {string} [crop] - 'center' etc., used with ratio.
  @param {number} [ratio] - Width / height decimal to crop Shopify images.

  @example
  {% render 'sf-image', image: product.featured_media, asset: 'sf-signature-front', sizes: '(min-width: 990px) 24vw, 78vw', class: 'sf-card__img' %}
{%- enddoc -%}
{%- liquid
  assign img_loading = loading | default: 'lazy'
  assign img_class = 'sf-img'
  if class != blank
    assign img_class = img_class | append: ' ' | append: class
  endif
-%}
{%- if image != blank -%}
  {%- liquid
    assign img_widths = widths | default: '360,540,720,960,1200,1440,1800,2200'
    assign last_width = img_widths | split: ',' | last | plus: 0
    assign intrinsic_w = image.width | default: last_width
    assign max_w = last_width | at_most: intrinsic_w
    assign img_alt = alt
    if alt == nil
      assign img_alt = image.alt | default: ''
    endif
    if ratio != blank
      assign max_h = max_w | divided_by: ratio | round
      assign img_src = image | image_url: width: max_w, height: max_h, crop: crop
    else
      assign img_src = image | image_url: width: max_w
    endif
  -%}
  {%- if fetchpriority != blank -%}
    {{- img_src | image_tag: widths: img_widths, sizes: sizes, loading: img_loading, fetchpriority: fetchpriority, decoding: 'async', class: img_class, alt: img_alt -}}
  {%- else -%}
    {{- img_src | image_tag: widths: img_widths, sizes: sizes, loading: img_loading, decoding: 'async', class: img_class, alt: img_alt -}}
  {%- endif -%}
{%- elsif asset != blank -%}
  {%- capture asset_rec -%}{% render 'sf-asset-data', asset: asset %}{%- endcapture -%}
  {%- assign asset_rec = asset_rec | strip -%}
  {%- if asset_rec != blank -%}
    {%- liquid
      assign rec = asset_rec | split: '|'
      assign rec_webp = rec[0] | split: ','
      assign rec_fw = rec[1]
      assign rec_ext = rec[2]
      assign rec_w = rec[3]
      assign rec_h = rec[4]
      assign img_alt = alt
      if alt == nil
        assign img_alt = rec[5] | default: ''
      endif
      assign fallback_file = asset | append: '-' | append: rec_fw | append: '.' | append: rec_ext
    -%}
    <picture class="sf-img-picture">
      {%- if rec_webp.size > 0 -%}
        <source type="image/webp" sizes="{{ sizes }}" srcset="
          {%- for w in rec_webp -%}
            {%- assign webp_file = asset | append: '-' | append: w | append: '.webp' -%}
            {{ webp_file | asset_url }} {{ w }}w{% unless forloop.last %}, {% endunless %}
          {%- endfor -%}
        ">
      {%- endif -%}
      <img class="{{ img_class }}" src="{{ fallback_file | asset_url }}" width="{{ rec_w }}" height="{{ rec_h }}" alt="{{ img_alt | escape }}" loading="{{ img_loading }}" decoding="async"{% if fetchpriority != blank %} fetchpriority="{{ fetchpriority }}"{% endif %}>
    </picture>
  {%- else -%}
    {{- 'image' | placeholder_svg_tag: 'sf-placeholder sf-img' -}}
  {%- endif -%}
{%- else -%}
  {{- 'image' | placeholder_svg_tag: 'sf-placeholder sf-img' -}}
{%- endif -%}

{%- doc -%}
  Section heading row: optional eyebrow, the heading, an optional piece count and an optional
  text link. The eyebrow renders only when filled (DESIGN anti-pattern 6).

  @param {string} heading - Heading text (Spectral, sentence case, as entered).
  @param {string} [eyebrow] - Micro label above the heading.
  @param {number} [level] - Heading level. Default 2.
  @param {string} [id] - Heading id, for aria-labelledby.
  @param {string} [align] - 'start' (default) | 'center'.
  @param {string} [link_label] - Text link label.
  @param {string} [link_url] - Text link URL.
  @param {number} [count] - Renders general.pieces ("24 pieces").
  @param {boolean} [visually_hidden] - Render only the heading, visually hidden.

  @example
  {% render 'sf-section-heading', heading: section.settings.heading, id: heading_id, count: collection.products_count, link_label: 'View all', link_url: collection.url %}
{%- enddoc -%}
{%- liquid
  assign h_level = level | default: 2
  assign h_align = align | default: 'start'
-%}
{%- if visually_hidden -%}
  <h{{ h_level }}{% if id != blank %} id="{{ id }}"{% endif %} class="sf-heading__title sf-visually-hidden">{{ heading }}</h{{ h_level }}>
{%- else -%}
  <div class="sf-heading sf-heading--{{ h_align }}">
    <div class="sf-heading__text">
      {%- if eyebrow != blank -%}<p class="sf-eyebrow">{{ eyebrow }}</p>{%- endif -%}
      <h{{ h_level }}{% if id != blank %} id="{{ id }}"{% endif %} class="sf-heading__title">{{ heading }}</h{{ h_level }}>
    </div>
    {%- if count != blank or link_url != blank -%}
      <div class="sf-heading__meta">
        {%- if count != blank -%}<p class="sf-heading__count">{{ 'general.pieces' | t: count: count }}</p>{%- endif -%}
        {%- if link_label != blank and link_url != blank -%}
          <a class="sf-btn sf-btn--text sf-btn--sm" href="{{ link_url }}"><span class="sf-btn__label">{{ link_label }}</span></a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
{%- endif -%}

<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    {%- render 'sf-head-boot' -%}
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="theme-color" content="{{ settings.color_ink | default: '#000000' }}">
    <meta name="robots" content="noindex">
    <link rel="canonical" href="{{ canonical_url }}">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- else -%}
      <link rel="icon" type="image/png" href="{{ 'sf-favicon-32.png' | asset_url }}">
    {%- endif -%}

    <title>{{ shop.name }}</title>
    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}
    {%- render 'sf-meta-tags' -%}

    <link rel="preload" as="font" type="font/woff2" href="{{ 'sf-font-text-400.woff2' | asset_url }}" crossorigin>
    <link rel="preload" as="font" type="font/woff2" href="{{ 'sf-font-label-500.woff2' | asset_url }}" crossorigin>

    {%- render 'sf-css-tokens' -%}
    {{ 'sf-base.css' | asset_url | stylesheet_tag }}

    {%- render 'sf-config-script' -%}
    <script src="{{ 'sf-core.js' | asset_url }}" defer></script>

    {{ content_for_header }}
  </head>

  <body class="sf-body sf-body--password sf-template-password">
    <a class="sf-skip-link" href="#MainContent">{{ 'accessibility.skip_to_content' | t }}</a>
    <main id="MainContent" class="sf-main" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>
    {%- render 'sf-live-regions' -%}
  </body>
</html>

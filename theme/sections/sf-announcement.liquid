{%- liquid
  assign messages = section.blocks | where: 'type', 'message'
  assign filled = 0
  for block in messages
    if block.settings.text != blank
      assign filled = filled | plus: 1
    endif
  endfor
  assign rotating = false
  if section.settings.rotate and filled > 1
    assign rotating = true
  endif
-%}
{%- if filled > 0 -%}
  <div class="sf-announcement sf-tone-{{ section.settings.tone | default: 'ink' }}{% if rotating %} sf-announcement--rotating{% endif %}" data-sf-announcement{% if rotating %} data-rotate="{{ section.settings.rotate_seconds | default: 6 }}"{% endif %}>
    <div class="sf-announcement__inner sf-container">
      <ul class="sf-announcement__list" role="list">
        {%- assign shown = 0 -%}
        {%- for block in messages -%}
          {%- if block.settings.text != blank -%}
            <li class="sf-announcement__item{% if shown == 0 %} is-active{% endif %}" data-sf-announcement-item {{ block.shopify_attributes }}>
              {%- if block.settings.link != blank -%}
                <a class="sf-announcement__link" href="{{ block.settings.link }}">{{ block.settings.text }}</a>
              {%- else -%}
                <span class="sf-announcement__text">{{ block.settings.text }}</span>
              {%- endif -%}
            </li>
            {%- assign shown = shown | plus: 1 -%}
          {%- endif -%}
        {%- endfor -%}
      </ul>
      {%- if rotating -%}
        <button type="button" class="sf-announcement__control" data-sf-announcement-toggle aria-pressed="false">
          <span class="sf-announcement__pause">{%- render 'sf-icon', name: 'pause', size: 14 -%}</span>
          <span class="sf-announcement__play">{%- render 'sf-icon', name: 'play', size: 14 -%}</span>
          <span class="sf-visually-hidden">{{ 'header.announcement_pause' | t }}</span>
        </button>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "class": "sf-shopify-section--announcement",
  "tag": "div",
  "enabled_on": { "groups": ["header"] },
  "max_blocks": 3,
  "settings": [
    {
      "type": "select",
      "id": "tone",
      "label": "Tone",
      "options": [
        { "value": "ink", "label": "Ink" },
        { "value": "charcoal", "label": "Charcoal" }
      ],
      "default": "ink"
    },
    { "type": "checkbox", "id": "rotate", "label": "Rotate messages", "default": false },
    {
      "type": "range",
      "id": "rotate_seconds",
      "label": "Seconds per message",
      "min": 4,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 6
    }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "text",
          "label": "Text",
          "info": "Keep it short. No countdowns or scarcity claims."
        },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [{ "name": "Announcement bar" }]
}
{% endschema %}

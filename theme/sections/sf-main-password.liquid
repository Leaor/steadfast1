{%- comment -%}
  Password page (ARCHITECTURE §2.4): textured wordmark, the store's password message, the
  newsletter form and the storefront password form inside a <details>. Centred on black.
{%- endcomment -%}
{{ 'sf-content.css' | asset_url | stylesheet_tag }}
<section class="sf-section sf-password sf-tone-ink sf-space-none" aria-labelledby="sf-password-title-{{ section.id }}">
  <div class="sf-password__inner sf-container">
    <h1 class="sf-password__logo" id="sf-password-title-{{ section.id }}">
      {%- render 'sf-logo', variant: 'textured', width: 520, loading: 'eager', fetchpriority: 'high', alt: shop.name -%}
    </h1>
    {%- if shop.password_message != blank -%}
      <p class="sf-password__message sf-text-xl">{{ shop.password_message | escape }}</p>
    {%- else -%}
      <p class="sf-password__message sf-text-xl">{{ 'password.heading' | t }}</p>
    {%- endif -%}

    <div class="sf-password__signup">
      <h2 class="sf-password__label sf-micro" id="sf-password-signup-{{ section.id }}">{{ 'password.signup_heading' | t }}</h2>
      {%- render 'sf-newsletter-form', id_suffix: section.id, show_consent: true -%}
    </div>

    {%- assign pw_open = false -%}
    {%- form 'storefront_password', class: 'sf-password__form' -%}
      {%- if form.errors -%}{%- assign pw_open = true -%}{%- endif -%}
      <details class="sf-password__details"{% if pw_open %} open{% endif %}>
        <summary class="sf-password__summary sf-btn sf-btn--text sf-btn--sm"><span class="sf-btn__label">{{ 'password.enter_password' | t }}</span></summary>
        <div class="sf-password__fields">
          <div class="sf-field">
            <label class="sf-field__label" for="sf-password-input">{{ 'password.password' | t }}</label>
            <div class="sf-password__row">
              <input class="sf-input" type="password" id="sf-password-input" name="password" autocomplete="current-password"{% if form.errors %} aria-invalid="true" aria-describedby="sf-password-error"{% endif %}>
              <button type="submit" class="sf-btn sf-btn--primary"><span class="sf-btn__label">{{ 'password.submit' | t }}</span></button>
            </div>
            {%- if form.errors -%}
              <p class="sf-field__error" id="sf-password-error">{%- render 'sf-icon', name: 'error', size: 16 -%}<span>{{ form.errors.messages.form | default: form.errors.messages.password }}</span></p>
            {%- endif -%}
          </div>
        </div>
      </details>
    {%- endform -%}
    <p class="sf-password__owner">{{ 'password.owner' | t }} <a href="/admin">{{ 'password.admin_link' | t }}</a></p>
  </div>
</section>

{% schema %}
{ "name": "Password", "class": "sf-shopify-section--main-password" }
{% endschema %}

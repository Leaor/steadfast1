{{ 'sf-brand-story.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign s = section.settings
  assign heading_id = 'sf-story-title-' | append: section.id
-%}
<section
  class="sf-section sf-brand-story sf-tone-{{ s.tone }} sf-space-{{ s.spacing }} sf-brand-story--{{ s.logo_display }}"
  data-sf-section="brand-story"
  aria-labelledby="{{ heading_id }}"
>
  <div class="sf-container sf-brand-story__inner">
    <h2 class="sf-visually-hidden" id="{{ heading_id }}">{{ s.heading | escape }}</h2>

    {%- if s.logo_display != 'none' -%}
      <div class="sf-brand-story__mark" data-sf-bs-mark>
        {%- if s.logo_display == 'textured' -%}
          <div class="sf-brand-story__base" aria-hidden="true">
            {%- render 'sf-logo', variant: 'lockup', width: 880, alt: '', sizes: '(min-width: 990px) min(60vw, 880px), min(84vw, 880px)' -%}
          </div>
          <div class="sf-brand-story__lit" data-sf-bs-sweep>
            {%- render 'sf-logo', variant: 'lockup', width: 880, alt: shop.name, sizes: '(min-width: 990px) min(60vw, 880px), min(84vw, 880px)' -%}
          </div>
        {%- else -%}
          <div class="sf-brand-story__base" aria-hidden="true">
            {%- render 'sf-logo', variant: 'flat', width: 880, alt: '' -%}
          </div>
          <div class="sf-brand-story__lit" data-sf-bs-sweep>
            {%- render 'sf-logo', variant: 'flat', width: 880, alt: shop.name -%}
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if s.text != blank or s.link_label != blank -%}
      <div class="sf-brand-story__copy" data-sf-bs-copy>
        {%- if s.text != blank -%}<div class="sf-brand-story__text">{{ s.text }}</div>{%- endif -%}
        {%- if s.link_label != blank and s.link != blank -%}
          <a class="sf-btn sf-btn--text sf-brand-story__link" href="{{ s.link }}"><span class="sf-btn__label">{{ s.link_label | escape }}</span></a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
  <script src="{{ 'sf-brand-story.js' | asset_url }}" defer></script>
</section>

{% schema %}
{
  "name": "Brand story",
  "tag": "div",
  "class": "sf-shopify-section--brand-story",
  "limit": 1,
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "About STEADFAST", "info": "Read by screen readers only; the wordmark is the visible subject." },
    {
      "type": "select",
      "id": "logo_display",
      "label": "Wordmark",
      "options": [
        { "value": "textured", "label": "Textured" },
        { "value": "flat", "label": "Flat" },
        { "value": "none", "label": "None" }
      ],
      "default": "textured"
    },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Steadfast. Firm in purpose, unmoved by noise.</p>", "info": "Replace with two or three sentences from STEADFAST. No dates, origins or claims until they are supplied." },
    { "type": "text", "id": "link_label", "label": "Link label" },
    { "type": "url", "id": "link", "label": "Link", "info": "The link shows only when both label and link are set." },
    {
      "type": "select",
      "id": "tone",
      "label": "Tone",
      "options": [
        { "value": "ink", "label": "Ink" },
        { "value": "charcoal", "label": "Charcoal" }
      ],
      "default": "ink"
    },
    {
      "type": "select",
      "id": "spacing",
      "label": "Vertical spacing",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "compact", "label": "Compact" },
        { "value": "standard", "label": "Standard" },
        { "value": "generous", "label": "Generous" }
      ],
      "default": "standard"
    }
  ],
  "presets": [{ "name": "Brand story" }]
}
{% endschema %}

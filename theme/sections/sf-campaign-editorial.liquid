{{ 'sf-campaign-editorial.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign s = section.settings
  assign heading_id = 'sf-campaign-title-' | append: section.id
  assign anchor = s.anchor_id | default: 'campaign' | handleize
-%}
<section
  id="{{ anchor }}"
  class="sf-section sf-campaign-editorial sf-tone-{{ s.tone }} sf-space-{{ s.spacing }} sf-campaign-editorial--{{ s.text_position }}"
  data-sf-section="campaign-editorial"
  {% if s.heading != blank %}aria-labelledby="{{ heading_id }}"{% endif %}
>
  <div class="sf-campaign-editorial__inner">
  <div class="sf-campaign-editorial__frame" data-sf-ce-frame>
    <div class="sf-campaign-editorial__media" data-sf-ce-media>
      <div class="sf-campaign-editorial__img sf-campaign-editorial__img--desktop">
        {%- render 'sf-image', image: s.image, asset: 'sf-campaign-back', sizes: '100vw', widths: '960,1280,1600,1920,2400,2560,3200', class: 'sf-campaign-editorial__picture' -%}
      </div>
      <div class="sf-campaign-editorial__img sf-campaign-editorial__img--mobile">
        {%- if s.image_mobile != blank -%}
          {%- render 'sf-image', image: s.image_mobile, sizes: '100vw', widths: '540,828,1200,1600', ratio: 0.8, crop: 'center', class: 'sf-campaign-editorial__picture' -%}
        {%- elsif s.image != blank -%}
          {%- render 'sf-image', image: s.image, sizes: '100vw', widths: '540,828,1200,1600', ratio: 0.8, crop: 'center', class: 'sf-campaign-editorial__picture' -%}
        {%- else -%}
          {%- render 'sf-image', asset: 'sf-campaign-back-portrait', sizes: '100vw', class: 'sf-campaign-editorial__picture' -%}
        {%- endif -%}
      </div>
    </div>
  </div>

  {%- if s.eyebrow != blank or s.heading != blank or s.text != blank -%}
    <div class="sf-campaign-editorial__copy-wrap sf-container">
      <div class="sf-campaign-editorial__copy" data-sf-ce-copy>
        {%- if s.eyebrow != blank -%}<p class="sf-campaign-editorial__eyebrow">{{ s.eyebrow | escape }}</p>{%- endif -%}
        {%- if s.heading != blank -%}<h2 class="sf-campaign-editorial__heading" id="{{ heading_id }}">{{ s.heading | escape }}</h2>{%- endif -%}
        {%- if s.text != blank -%}<div class="sf-campaign-editorial__text">{{ s.text }}</div>{%- endif -%}
        {%- if s.link_label != blank and s.link != blank -%}
          <a class="sf-btn sf-btn--text sf-campaign-editorial__link" href="{{ s.link }}"><span class="sf-btn__label">{{ s.link_label | escape }}</span></a>
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}
  </div>
  <script src="{{ 'sf-campaign-editorial.js' | asset_url }}" defer></script>
</section>

{% schema %}
{
  "name": "Campaign editorial",
  "tag": "div",
  "class": "sf-shopify-section--campaign-editorial",
  "limit": 1,
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "anchor_id", "label": "Anchor", "default": "campaign", "info": "The hero's secondary button links to #campaign by default." },
    { "type": "image_picker", "id": "image", "label": "Image, desktop (16:9)" },
    { "type": "image_picker", "id": "image_mobile", "label": "Image, mobile (4:5)", "info": "Blank crops the desktop image to 4:5." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "info": "Blank by default: the hero carries the only campaign label." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Under one light.", "info": "One short editorial line." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>The tracksuit in stone, seen from behind.</p>", "info": "Describe only what's in the photo. No dates, origins, materials or claims until STEADFAST supplies them." },
    { "type": "text", "id": "link_label", "label": "Link label" },
    { "type": "url", "id": "link", "label": "Link", "info": "The link shows only when both label and link are set." },
    {
      "type": "select",
      "id": "text_position",
      "label": "Text position on desktop",
      "options": [
        { "value": "middle-left", "label": "Left, vertically centred in the void" },
        { "value": "bottom-left", "label": "Bottom left" },
        { "value": "center", "label": "Centre" }
      ],
      "default": "middle-left"
    },
    {
      "type": "select",
      "id": "tone",
      "label": "Tone",
      "options": [
        { "value": "ink", "label": "Ink" },
        { "value": "charcoal", "label": "Charcoal" }
      ],
      "default": "ink"
    },
    {
      "type": "select",
      "id": "spacing",
      "label": "Vertical spacing",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "compact", "label": "Compact" },
        { "value": "standard", "label": "Standard" },
        { "value": "generous", "label": "Generous" }
      ],
      "default": "standard"
    }
  ],
  "presets": [{ "name": "Campaign editorial" }]
}
{% endschema %}

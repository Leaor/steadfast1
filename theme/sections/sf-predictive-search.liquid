{%- comment -%}
  Predictive search results (DESIGN §7.4). Rendered only through /search/suggest with
  section_id=sf-predictive-search; injected into the overlay's [data-sf-predictive-body].
  A listbox of options (links are not tab stops; the input keeps focus, aria-activedescendant moves).
{%- endcomment -%}
{%- liquid
  assign ps = predictive_search.resources
  assign total = ps.products.size | plus: ps.queries.size | plus: ps.collections.size | plus: ps.pages.size | plus: ps.articles.size
  assign terms = predictive_search.terms | default: ''
  assign opt = 0
-%}
<div data-sf-predictive-body>
  {%- if predictive_search.performed -%}
    <div class="sf-ps" id="sf-predictive-results" role="listbox" aria-label="{{ 'search.suggestions' | t | escape }}" data-count="{{ total }}">
      {%- if ps.products.size > 0 -%}
        <div class="sf-ps__group sf-ps__group--products" role="group" aria-labelledby="sf-ps-h-products">
          <p class="sf-ps__heading" id="sf-ps-h-products">{{ 'search.products' | t }}</p>
          <div class="sf-ps__products">
            {%- for product in ps.products -%}
              {%- assign opt = opt | plus: 1 -%}
              <div class="sf-ps__option sf-ps__product" role="option" id="sf-ps-opt-{{ opt }}" aria-selected="false">
                <a class="sf-ps__link" href="{{ product.url }}" tabindex="-1">
                  <span class="sf-ps__thumb">
                    {%- if product.featured_media != blank -%}
                      {%- render 'sf-image', image: product.featured_media, widths: '120,240,360', sizes: '(min-width: 990px) 140px, 22vw', alt: '', class: 'sf-ps__img' -%}
                    {%- else -%}
                      {{- 'product-apparel-1' | placeholder_svg_tag: 'sf-placeholder sf-ps__img' -}}
                    {%- endif -%}
                  </span>
                  <span class="sf-ps__name">{{ product.title | escape }}</span>
                  {%- if settings.predictive_search_show_price -%}
                    <span class="sf-ps__price sf-tabular">
                      {%- if product.price_varies -%}{%- assign pmin = product.price_min | money -%}{{ 'price.from' | t: price: pmin }}{%- else -%}{{ product.price | money }}{%- endif -%}
                    </span>
                    {%- unless product.available -%}<span class="sf-ps__sold">{{ 'products.sold_out' | t }}</span>{%- endunless -%}
                  {%- endif -%}
                </a>
              </div>
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}
      <div class="sf-ps__side">
        {%- if ps.queries.size > 0 -%}
          <div class="sf-ps__group" role="group" aria-labelledby="sf-ps-h-queries">
            <p class="sf-ps__heading" id="sf-ps-h-queries">{{ 'search.suggestions' | t }}</p>
            {%- for query in ps.queries -%}
              {%- assign opt = opt | plus: 1 -%}
              <div class="sf-ps__option" role="option" id="sf-ps-opt-{{ opt }}" aria-selected="false">
                <a class="sf-ps__link sf-ps__text" href="{{ query.url }}" tabindex="-1">{{ query.styled_text }}</a>
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}
        {%- if ps.collections.size > 0 -%}
          <div class="sf-ps__group" role="group" aria-labelledby="sf-ps-h-collections">
            <p class="sf-ps__heading" id="sf-ps-h-collections">{{ 'search.collections' | t }}</p>
            {%- for collection in ps.collections -%}
              {%- assign opt = opt | plus: 1 -%}
              <div class="sf-ps__option" role="option" id="sf-ps-opt-{{ opt }}" aria-selected="false">
                <a class="sf-ps__link sf-ps__text" href="{{ collection.url }}" tabindex="-1">{{ collection.title | escape }}</a>
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}
        {%- assign others = ps.pages.size | plus: ps.articles.size -%}
        {%- if others > 0 -%}
          <div class="sf-ps__group" role="group" aria-labelledby="sf-ps-h-pages">
            <p class="sf-ps__heading" id="sf-ps-h-pages">{{ 'search.other_results' | t }}</p>
            {%- for page in ps.pages -%}
              {%- assign opt = opt | plus: 1 -%}
              <div class="sf-ps__option" role="option" id="sf-ps-opt-{{ opt }}" aria-selected="false">
                <a class="sf-ps__link sf-ps__text" href="{{ page.url }}" tabindex="-1">{{ page.title | escape }}</a>
              </div>
            {%- endfor -%}
            {%- for article in ps.articles -%}
              {%- assign opt = opt | plus: 1 -%}
              <div class="sf-ps__option" role="option" id="sf-ps-opt-{{ opt }}" aria-selected="false">
                <a class="sf-ps__link sf-ps__text" href="{{ article.url }}" tabindex="-1">{{ article.title | escape }}</a>
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}
        {%- if total == 0 -%}
          <p class="sf-ps__empty">{%- assign terms_esc = terms | escape -%}{{ 'search.no_results_html' | t: terms: terms_esc }}</p>
        {%- endif -%}
        {%- assign opt = opt | plus: 1 -%}
        <div class="sf-ps__option sf-ps__search-for" role="option" id="sf-ps-opt-{{ opt }}" aria-selected="false">
          <a class="sf-ps__link" href="{{ routes.search_url }}?q={{ terms | url_encode }}&amp;options%5Bprefix%5D=last" tabindex="-1">
            <span>{{ 'search.search_for' | t: terms: terms }}</span>{%- render 'sf-icon', name: 'arrow-right', size: 16 -%}
          </a>
        </div>
      </div>
    </div>
  {%- else -%}
    <div id="sf-predictive-results" role="listbox" aria-label="{{ 'search.suggestions' | t | escape }}" hidden></div>
  {%- endif -%}
</div>

{% schema %}
{ "name": "Predictive search" }
{% endschema %}

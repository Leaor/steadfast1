{%- liquid
  assign hdr = section.settings
  assign is_transparent = false
  if hdr.transparent_on_home and template.name == 'index'
    assign is_transparent = true
  endif
  assign sticky = hdr.sticky_behavior | default: 'on-scroll-up'
  assign show_account = false
  if hdr.show_account and shop.customer_accounts_enabled
    assign show_account = true
  endif
  assign logo_w_d = settings.logo_width_desktop | default: 148
  assign logo_condensed = 120.0 | divided_by: logo_w_d | at_most: 1 | round: 3
  assign cart_opens_drawer = false
  if settings.cart_type == 'drawer'
    assign cart_opens_drawer = true
  endif
-%}
<header class="sf-header" data-sf-header data-sticky="{{ sticky }}" data-transparent="{{ is_transparent }}" data-state="{% if is_transparent %}transparent{% else %}solid{% endif %}" data-condensed="false" data-hidden="false" style="--sf-logo-w-d: {{ logo_w_d }}px; --sf-logo-w-m: {{ settings.logo_width_mobile | default: 112 }}px; --sf-logo-condensed: {{ logo_condensed }};">
  <sf-header class="sf-header__bar" data-sticky="{{ sticky }}" data-transparent="{{ is_transparent }}">
    <span class="sf-header__scrim" aria-hidden="true"></span>
    <span class="sf-header__surface" aria-hidden="true"></span>
    <div class="sf-header__inner sf-container">
      <div class="sf-header__start">
        {%- comment -%} First in DOM so the mobile focus order matches the visual order (WCAG 2.4.3). {%- endcomment -%}
        <button type="button" class="sf-header__action sf-header__action--menu sf-header__icon-btn" data-sf-open="menu" aria-expanded="false" aria-controls="sf-menu-drawer" aria-haspopup="dialog" aria-label="{{ 'header.menu_open' | t }}">
          {%- render 'sf-icon', name: 'menu', size: 20 -%}
        </button>
        {%- render 'sf-nav-desktop', menu: hdr.menu, secondary_menu: hdr.mega_secondary_menu, blocks: section.blocks -%}
      </div>

      {%- liquid
        # Brief §2: keep the distressed texture where the mark is large enough to carry it (≥ 148 px
        # letters, desktop, not condensed); the flat SVG stays for the condensed bar and < 990 px.
        assign logo_textured = false
        if settings.logo == blank and logo_w_d >= 148
          assign logo_textured = true
          assign logo_tex_w = logo_w_d | times: 1.0 | divided_by: 0.9215 | round
          assign logo_tex_sizes = logo_tex_w | append: 'px'
        endif
      -%}
      <a class="sf-header__logo{% if logo_textured %} sf-header__logo--textured{% endif %}" href="{{ routes.root_url }}" aria-label="{{ 'header.home_label' | t: shop: shop.name }}">
        <span class="sf-header__logo-flat">{%- render 'sf-logo', variant: 'flat', width: logo_w_d, loading: 'eager' -%}</span>
        {%- if logo_textured -%}
          <span class="sf-header__logo-tex" aria-hidden="true">{%- render 'sf-logo', variant: 'textured', width: logo_tex_w, class: 'sf-logo--fit', sizes: logo_tex_sizes, alt: '' -%}</span>
        {%- endif -%}
      </a>

      <div class="sf-header__actions">
        {%- if hdr.show_search -%}
          <a class="sf-header__action sf-header__action--search" href="{{ routes.search_url }}" data-sf-open="search" aria-haspopup="dialog">
            <span class="sf-header__text">{{ 'header.search' | t }}</span>
            <span class="sf-header__glyph">{%- render 'sf-icon', name: 'search', size: 20 -%}<span class="sf-visually-hidden">{{ 'header.search' | t }}</span></span>
          </a>
        {%- endif -%}
        {%- if show_account -%}
          {%- comment -%}
            Shopify's account component (Theme Store requirement; new customer accounts open its account
            sheet, legacy accounts link to sign-in). Until Shopify defines the element (and with no JS),
            the plain account link below is shown instead.
          {%- endcomment -%}
          {%- assign account_menu = hdr.customer_account_menu.handle | default: 'customer-account-main-menu' -%}
          <shopify-account class="sf-header__account" menu="{{ account_menu }}">
            <span slot="signed-out-avatar" class="sf-header__account-avatar">{%- render 'sf-icon', name: 'account', size: 20 -%}</span>
          </shopify-account>
          <a class="sf-header__action sf-header__action--account" href="{{ routes.account_url }}">
            <span class="sf-header__text">{{ 'header.account' | t }}</span>
          </a>
        {%- endif -%}
        <a class="sf-header__action sf-header__action--cart" href="{{ routes.cart_url }}"{% if cart_opens_drawer %} data-sf-open="cart" aria-haspopup="dialog"{% endif %}>
          <span class="sf-header__text">{{ 'header.cart' | t }} (<sf-cart-count data-count="{{ cart.item_count }}">{{ cart.item_count }}</sf-cart-count>)</span>
          <span class="sf-header__glyph">
            {%- render 'sf-icon', name: 'bag', size: 20 -%}<span class="sf-visually-hidden">{{ 'header.cart' | t }}</span>
            <sf-cart-count class="sf-header__count" data-count="{{ cart.item_count }}">{{ cart.item_count }}</sf-cart-count>
          </span>
        </a>
        {%- if hdr.show_localization -%}
          <div class="sf-header__localization">
            {%- render 'sf-localization-form', id_suffix: 'header' -%}
          </div>
        {%- endif -%}
      </div>
    </div>
    <span class="sf-header__mega-scrim" data-sf-mega-scrim aria-hidden="true"></span>
  </sf-header>
</header>

{%- render 'sf-menu-drawer', menu: hdr.menu, secondary_menu: hdr.secondary_menu, logo_width: settings.logo_width_mobile -%}

{% schema %}
{
  "name": "Header",
  "class": "sf-shopify-section--header",
  "tag": "div",
  "enabled_on": { "groups": ["header"] },
  "max_blocks": 2,
  "settings": [
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu" },
    {
      "type": "link_list",
      "id": "mega_secondary_menu",
      "label": "Mega menu: collections column",
      "info": "Optional. A quiet text column in the first menu item's panel."
    },
    {
      "type": "select",
      "id": "sticky_behavior",
      "label": "Sticky header",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "always", "label": "Always" },
        { "value": "on-scroll-up", "label": "On scroll up" }
      ],
      "default": "on-scroll-up"
    },
    {
      "type": "checkbox",
      "id": "transparent_on_home",
      "label": "Transparent over the homepage hero",
      "default": true
    },
    { "type": "checkbox", "id": "show_search", "label": "Show search", "default": true },
    {
      "type": "checkbox",
      "id": "show_account",
      "label": "Show account",
      "default": true,
      "info": "Shown only when customer accounts are enabled."
    },
    {
      "type": "link_list",
      "id": "customer_account_menu",
      "label": "Customer account menu",
      "default": "customer-account-main-menu",
      "info": "Shown in the account sheet that opens from the account icon."
    },
    {
      "type": "checkbox",
      "id": "show_localization",
      "label": "Show country selector in the header",
      "default": false,
      "info": "Desktop only. The footer and mobile menu always show it when enabled in theme settings."
    },
    {
      "type": "link_list",
      "id": "secondary_menu",
      "label": "Mobile menu: secondary links",
      "info": "Optional. Shown below the main links."
    }
  ],
  "blocks": [
    {
      "type": "menu_promo",
      "name": "Menu image",
      "limit": 2,
      "settings": [
        {
          "type": "text",
          "id": "menu_item",
          "label": "Menu item",
          "info": "The exact title of the top-level menu link this image appears under, e.g. Shop."
        },
        { "type": "image_picker", "id": "image", "label": "Image", "info": "Leads the panel's 3:4 image stage." },
        { "type": "text", "id": "heading", "label": "Caption", "info": "Optional text link under the image." },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ]
}
{% endschema %}

{%- comment -%} Order detail (classic customer accounts). Only Shopify's own data. {%- endcomment -%}
{{ 'sf-content.css' | asset_url | stylesheet_tag }}
{{ 'sf-customer.css' | asset_url | stylesheet_tag }}
<section class="sf-section sf-customer sf-order sf-tone-ink sf-space-compact" aria-labelledby="sf-order-title">
  <div class="sf-container">
    <header class="sf-account__header">
      <a class="sf-btn sf-btn--text sf-btn--sm sf-order__back" href="{{ routes.account_url }}"><span class="sf-btn__label">{{ 'customer.order.back' | t }}</span></a>
      <h1 class="sf-customer__title sf-display-lg" id="sf-order-title">{{ 'customer.order.title' | t: name: order.name }}</h1>
      {%- assign order_date = order.created_at | time_tag: '%B %-d, %Y' -%}
      <p class="sf-account__greeting">{{ 'customer.order.date' | t: date: order_date }}</p>
      {%- if order.cancelled -%}
        {%- assign cancelled_date = order.cancelled_at | time_tag: '%B %-d, %Y' -%}
        <p class="sf-order__cancelled">{{ 'customer.order.cancelled' | t: date: cancelled_date }}</p>
      {%- endif -%}
      {%- render 'sf-account-nav', current: 'order' -%}
    </header>
    <div class="sf-account__grid">
      <div class="sf-order__items">
        <div class="sf-table-wrap">
          <table class="sf-table sf-order__table">
            <caption class="sf-visually-hidden">{{ 'customer.order.title' | t: name: order.name }}</caption>
            <thead>
              <tr>
                <th scope="col">{{ 'customer.order.product' | t }}</th>
                <th scope="col" class="sf-table__num">{{ 'customer.order.price' | t }}</th>
                <th scope="col" class="sf-table__num">{{ 'customer.order.quantity' | t }}</th>
                <th scope="col" class="sf-table__num">{{ 'customer.order.total' | t }}</th>
              </tr>
            </thead>
            <tbody>
              {%- for line_item in order.line_items -%}
                <tr>
                  <th scope="row" data-label="{{ 'customer.order.product' | t | escape }}">
                    {%- if line_item.url != blank -%}<a href="{{ line_item.url }}">{{ line_item.title | escape }}</a>{%- else -%}{{ line_item.title | escape }}{%- endif -%}
                    {%- if line_item.sku != blank -%}<span class="sf-order__sku">{{ 'customer.order.sku' | t }}: {{ line_item.sku | escape }}</span>{%- endif -%}
                  </th>
                  <td class="sf-table__num sf-tabular" data-label="{{ 'customer.order.price' | t | escape }}">{{ line_item.final_price | money }}</td>
                  <td class="sf-table__num sf-tabular" data-label="{{ 'customer.order.quantity' | t | escape }}">{{ line_item.quantity }}</td>
                  <td class="sf-table__num sf-tabular" data-label="{{ 'customer.order.total' | t | escape }}">{{ line_item.final_line_price | money }}</td>
                </tr>
              {%- endfor -%}
            </tbody>
          </table>
        </div>
        <dl class="sf-order__totals">
          <div><dt>{{ 'customer.order.subtotal' | t }}</dt><dd class="sf-tabular">{{ order.subtotal_price | money }}</dd></div>
          {%- if order.shipping_price != blank -%}<div><dt>{{ 'customer.order.shipping' | t }}</dt><dd class="sf-tabular">{{ order.shipping_price | money }}</dd></div>{%- endif -%}
          {%- if order.total_tax != blank -%}<div><dt>{{ 'customer.order.tax' | t }}</dt><dd class="sf-tabular">{{ order.total_tax | money }}</dd></div>{%- endif -%}
          <div class="sf-order__grand"><dt>{{ 'customer.order.total' | t }}</dt><dd class="sf-tabular">{{ order.total_price | money }}</dd></div>
        </dl>
      </div>
      <aside class="sf-account__details">
        <h2 class="sf-account__section-title sf-micro">{{ 'customer.order.payment_status' | t }}</h2>
        <p class="sf-account__status">{{ order.financial_status_label }}</p>
        <h2 class="sf-account__section-title sf-micro">{{ 'customer.order.fulfillment_status' | t }}</h2>
        <p class="sf-account__status">{{ order.fulfillment_status_label }}</p>
        {%- if order.shipping_address != blank -%}
          <h2 class="sf-account__section-title sf-micro">{{ 'customer.order.shipping_address' | t }}</h2>
          <div class="sf-account__address">{{ order.shipping_address | format_address }}</div>
        {%- endif -%}
        {%- if order.billing_address != blank -%}
          <h2 class="sf-account__section-title sf-micro">{{ 'customer.order.billing_address' | t }}</h2>
          <div class="sf-account__address">{{ order.billing_address | format_address }}</div>
        {%- endif -%}
        {%- if order.order_status_url != blank -%}
          <a class="sf-btn sf-btn--text sf-btn--sm" href="{{ order.order_status_url }}"><span class="sf-btn__label">{{ 'customer.order.status_page' | t }}</span></a>
        {%- endif -%}
      </aside>
    </div>
  </div>
</section>

{% schema %}
{ "name": "Order", "class": "sf-shopify-section--main-order" }
{% endschema %}

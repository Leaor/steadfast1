{{ 'sf-signature-showcase.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign s = section.settings
  assign p = s.product
  assign heading_id = 'sf-signature-title-' | append: section.id
  assign heading = s.heading
  if heading == blank and p != blank
    assign heading = p.title
  endif
  assign label_title = heading
  if p != blank
    assign label_title = p.title
  endif
  assign cta_url = s.cta_link
  if cta_url == blank
    if p != blank
      assign cta_url = p.url
    else
      assign cta_url = routes.all_products_collection_url
    endif
  endif
  assign stage_widths = '1600,2400,2730'
-%}
<section
  class="sf-section sf-signature-showcase sf-tone-{{ s.tone }} sf-space-{{ s.spacing }}{% if s.pin_on_desktop %} sf-signature-showcase--pin{% endif %}"
  data-sf-section="signature-showcase"
  data-scroll-length="{{ s.scroll_length }}"
  aria-label="{{ 'home.signature.label' | t: title: label_title | escape }}"
>
  <div class="sf-signature-showcase__inner" data-sf-ss-pin>
    {%- comment -%} Desktop stage (motion "full", ≥ 990 px): front and back stills, aligned; zoomed by the scroll timeline. {%- endcomment -%}
    <div class="sf-signature-showcase__stage" aria-hidden="true">
      <div class="sf-signature-showcase__persp">
        <div class="sf-signature-showcase__face" data-sf-ss-front>
          <div class="sf-signature-showcase__layer" data-sf-ss-layer>
            {%- render 'sf-image', image: s.image_hero, asset: 'sf-signature-hero', sizes: '2730px', widths: stage_widths, class: 'sf-signature-showcase__stage-img', alt: '' -%}
          </div>
        </div>
        <div class="sf-signature-showcase__face sf-signature-showcase__face--back" data-sf-ss-back>
          <div class="sf-signature-showcase__layer">
            {%- render 'sf-image', image: s.image_hero_back, asset: 'sf-signature-hero-back', sizes: '2730px', widths: stage_widths, class: 'sf-signature-showcase__stage-img', alt: '' -%}
          </div>
        </div>
      </div>
      <div class="sf-signature-showcase__vignette" data-sf-ss-vignette></div>
      <div class="sf-signature-showcase__exposure" data-sf-ss-exposure></div>
    </div>

    <div class="sf-signature-showcase__intro" data-sf-ss-intro>
      {%- if s.eyebrow != blank -%}<p class="sf-signature-showcase__eyebrow">{{ s.eyebrow | escape }}</p>{%- endif -%}
      <h2 class="sf-signature-showcase__heading" id="{{ heading_id }}">{{ heading | escape }}</h2>
    </div>

    {%- comment -%} Stacked layout (mobile, "subtle", reduced, pin off): 4:5 front and back. {%- endcomment -%}
    <div class="sf-signature-showcase__views">
      <div class="sf-signature-showcase__view is-active" data-sf-ss-view="front" data-sf-reveal="exposure">
        {%- render 'sf-image', image: s.image_front, asset: 'sf-signature-front', sizes: '(min-width: 990px) 46vw, calc(100vw - 32px)', widths: '600,900,1200', class: 'sf-signature-showcase__view-img' -%}
      </div>
      <div class="sf-signature-showcase__view" data-sf-ss-view="back">
        {%- render 'sf-image', image: s.image_back, asset: 'sf-signature-back', sizes: '(min-width: 990px) 46vw, calc(100vw - 32px)', widths: '600,900,1200', class: 'sf-signature-showcase__view-img' -%}
      </div>
    </div>

    {%- if section.blocks.size > 0 -%}
      <ul class="sf-signature-showcase__details" role="list" aria-label="{{ 'home.signature.details' | t }}">
        {%- for block in section.blocks -%}
          {%- assign b = block.settings -%}
          {%- assign crop_asset = 'sf-signature-detail-' | append: b.asset_crop -%}
          <li class="sf-signature-showcase__detail" data-sf-ss-detail data-crop="{{ b.asset_crop }}" {{ block.shopify_attributes }}>
            <div class="sf-signature-showcase__detail-media">
              {%- render 'sf-image', image: b.image, asset: crop_asset, sizes: '(min-width: 990px) 23vw, 72vw', widths: '400,720', ratio: 1, crop: 'center', class: 'sf-signature-showcase__detail-img', alt: '' -%}
            </div>
            <div class="sf-signature-showcase__caption">
              {%- if b.title != blank -%}<p class="sf-signature-showcase__detail-title">{{ b.title | escape }}</p>{%- endif -%}
              {%- if b.text != blank -%}<p class="sf-signature-showcase__detail-text">{{ b.text | escape }}</p>{%- endif -%}
            </div>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    <div class="sf-signature-showcase__buy" data-sf-ss-buy>
      <div class="sf-signature-showcase__toggle" role="group" aria-label="{{ 'home.signature.view' | t }}" data-sf-ss-toggle hidden>
        <button type="button" class="sf-signature-showcase__face-btn" data-sf-ss-face="front" aria-pressed="true">{{ 'home.signature.front' | t }}</button>
        <button type="button" class="sf-signature-showcase__face-btn" data-sf-ss-face="back" aria-pressed="false">{{ 'home.signature.back' | t }}</button>
      </div>
      {%- if p != blank -%}
        <p class="sf-signature-showcase__title">{{ p.title | escape }}</p>
        {%- render 'sf-price', product: p, show_from: true, class: 'sf-signature-showcase__price' -%}
      {%- endif -%}
      {%- if s.cta_label != blank -%}
        <a class="sf-btn sf-btn--primary sf-signature-showcase__cta" href="{{ cta_url }}">
          <span class="sf-btn__label">{{ s.cta_label | escape }}</span>
        </a>
      {%- endif -%}
    </div>
  </div>
  <script src="{{ 'sf-signature-showcase.js' | asset_url }}" defer></script>
</section>

{% schema %}
{
  "name": "Signature showcase",
  "tag": "div",
  "class": "sf-shopify-section--signature-showcase",
  "limit": 1,
  "max_blocks": 5,
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "product", "id": "product", "label": "Product", "info": "Shows the live price and links the button to the product." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Signature piece" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The zip hoodie", "info": "Blank uses the product title." },
    { "type": "header", "content": "Desktop stage (16:9)" },
    { "type": "image_picker", "id": "image_hero", "label": "Front on black", "info": "16:9, the garment centred on true black." },
    { "type": "image_picker", "id": "image_hero_back", "label": "Back on black", "info": "16:9, aligned to the front image so the turn reads as one piece." },
    { "type": "header", "content": "Mobile and reduced motion (4:5)" },
    { "type": "image_picker", "id": "image_front", "label": "Front" },
    { "type": "image_picker", "id": "image_back", "label": "Back" },
    { "type": "header", "content": "Button" },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Shop the zip hoodie" },
    { "type": "url", "id": "cta_link", "label": "Button link", "info": "Blank links to the product, or to all products." },
    { "type": "header", "content": "Scroll" },
    { "type": "checkbox", "id": "pin_on_desktop", "label": "Pin and scroll through details on desktop", "default": true },
    {
      "type": "select",
      "id": "scroll_length",
      "label": "Scroll length",
      "options": [
        { "value": "short", "label": "Short" },
        { "value": "standard", "label": "Standard" }
      ],
      "default": "standard"
    },
    {
      "type": "select",
      "id": "tone",
      "label": "Tone",
      "options": [
        { "value": "ink", "label": "Ink" },
        { "value": "charcoal", "label": "Charcoal" }
      ],
      "default": "ink"
    },
    {
      "type": "select",
      "id": "spacing",
      "label": "Vertical spacing",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "compact", "label": "Compact" },
        { "value": "standard", "label": "Standard" },
        { "value": "generous", "label": "Generous" }
      ],
      "default": "standard",
      "info": "Applies when the section is not pinned."
    }
  ],
  "blocks": [
    {
      "type": "detail",
      "name": "Detail",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image (square)", "info": "Optional. Blank uses the bundled crop below." },
        {
          "type": "select",
          "id": "asset_crop",
          "label": "Detail",
          "options": [
            { "value": "zip", "label": "Zip and neck label" },
            { "value": "chest-logo", "label": "Chest logo" },
            { "value": "shoulder", "label": "Shoulder" },
            { "value": "cuff-label", "label": "Sleeve label" },
            { "value": "neck-label", "label": "Neck label" }
          ],
          "default": "zip",
          "info": "Also sets where the desktop stage zooms in."
        },
        { "type": "text", "id": "title", "label": "Title", "info": "Describe only what is visible. Add construction or material terms only when STEADFAST confirms them." },
        { "type": "text", "id": "text", "label": "Text" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Signature showcase",
      "blocks": [
        { "type": "detail", "settings": { "asset_crop": "zip", "title": "Zip and neck label" } },
        { "type": "detail", "settings": { "asset_crop": "chest-logo", "title": "Distressed chest logo" } },
        { "type": "detail", "settings": { "asset_crop": "shoulder", "title": "Shoulder embellishment" } },
        { "type": "detail", "settings": { "asset_crop": "cuff-label", "title": "Sleeve label" } }
      ]
    }
  ]
}
{% endschema %}

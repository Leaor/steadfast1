{%- comment -%}
  Contact form (DESIGN §6.4): native {% form 'contact' %}. Errors are summarised (focused on
  load) and linked to each field with aria-describedby; success replaces nothing, it confirms.
{%- endcomment -%}
{{ 'sf-content.css' | asset_url | stylesheet_tag }}
<script src="{{ 'sf-customer.js' | asset_url }}" defer></script>
<section class="sf-section sf-content sf-contact sf-tone-ink sf-space-compact" aria-labelledby="sf-contact-title-{{ section.id }}">
  <div class="sf-container sf-content__grid">
    <h2 class="sf-contact__title sf-text-xl" id="sf-contact-title-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
    {%- form 'contact', id: 'contact_form', class: 'sf-form sf-contact__form', novalidate: 'novalidate' -%}
      {%- if form.posted_successfully? -%}
        <p class="sf-form__success" role="status" tabindex="-1" data-sf-form-status>{%- render 'sf-icon', name: 'check', size: 16 -%}{{ 'contact.success' | t }}</p>
      {%- endif -%}
      {%- if form.errors -%}
        <div class="sf-form__errors" role="alert" tabindex="-1" data-sf-error-summary>
          <p class="sf-form__errors-title">{%- render 'sf-icon', name: 'error', size: 16 -%}{{ 'contact.errors_heading' | t }}</p>
          <ul role="list">
            {%- for field in form.errors -%}
              <li><a href="#ContactForm-{{ field }}">{{ form.errors.translated_fields[field] | capitalize }} {{ form.errors.messages[field] }}</a></li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}
      <div class="sf-form__row">
        <div class="sf-field">
          <label class="sf-field__label" for="ContactForm-name">{{ 'contact.name' | t }}</label>
          <input class="sf-input" type="text" id="ContactForm-name" name="contact[name]" autocomplete="name" value="{% if form.name %}{{ form.name | escape }}{% elsif customer %}{{ customer.name | escape }}{% endif %}">
        </div>
        <div class="sf-field">
          <label class="sf-field__label" for="ContactForm-email">{{ 'contact.email' | t }} <span aria-hidden="true">*</span></label>
          <input class="sf-input" type="email" id="ContactForm-email" name="contact[email]" autocomplete="email" spellcheck="false" autocapitalize="off" required aria-required="true" value="{% if form.email %}{{ form.email | escape }}{% elsif customer %}{{ customer.email | escape }}{% endif %}"{% if form.errors contains 'email' %} aria-invalid="true" aria-describedby="ContactForm-email-error"{% endif %}>
          {%- if form.errors contains 'email' -%}
            <p class="sf-field__error" id="ContactForm-email-error">{%- render 'sf-icon', name: 'error', size: 16 -%}<span>{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</span></p>
          {%- endif -%}
        </div>
      </div>
      <div class="sf-field">
        <label class="sf-field__label" for="ContactForm-phone">{{ 'contact.phone' | t }}</label>
        <input class="sf-input" type="tel" id="ContactForm-phone" name="contact[phone]" autocomplete="tel" pattern="[0-9\-\+\s\(\)]*" value="{{ form.phone | escape }}">
      </div>
      <div class="sf-field">
        <label class="sf-field__label" for="ContactForm-body">{{ 'contact.message' | t }}</label>
        <textarea class="sf-textarea" id="ContactForm-body" name="contact[body]" rows="6"{% if form.errors contains 'body' %} aria-invalid="true" aria-describedby="ContactForm-body-error"{% endif %}>{{ form.body }}</textarea>
        {%- if form.errors contains 'body' -%}
          <p class="sf-field__error" id="ContactForm-body-error">{%- render 'sf-icon', name: 'error', size: 16 -%}<span>{{ form.errors.translated_fields.body | capitalize }} {{ form.errors.messages.body }}</span></p>
        {%- endif -%}
      </div>
      <div class="sf-form__actions">
        <button type="submit" class="sf-btn sf-btn--primary"><span class="sf-btn__label">{{ 'contact.submit' | t }}</span></button>
      </div>
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Contact form",
  "class": "sf-shopify-section--contact-form",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Contact" }
  ],
  "presets": [ { "name": "Contact form" } ]
}
{% endschema %}

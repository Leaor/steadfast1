{%- comment -%} Create account (classic customer accounts). {%- endcomment -%}
{{ 'sf-content.css' | asset_url | stylesheet_tag }}
{{ 'sf-customer.css' | asset_url | stylesheet_tag }}
<script src="{{ 'sf-customer.js' | asset_url }}" defer></script>
<section class="sf-section sf-customer sf-customer--narrow sf-tone-ink sf-space-compact" aria-labelledby="sf-register-title">
  <div class="sf-container sf-customer__inner">
    <h1 class="sf-customer__title sf-display-md" id="sf-register-title">{{ 'customer.register.title' | t }}</h1>
    {%- form 'create_customer', class: 'sf-form', novalidate: 'novalidate' -%}
      {%- if form.errors -%}
        <div class="sf-form__errors" role="alert" tabindex="-1" data-sf-error-summary>
          <p class="sf-form__errors-title">{%- render 'sf-icon', name: 'error', size: 16 -%}{{ 'customer.errors_heading' | t }}</p>
          <ul role="list">
            {%- for field in form.errors -%}
              <li>{% if field == 'form' %}{{ form.errors.messages[field] }}{% else %}<a href="#RegisterForm-{{ field }}">{{ form.errors.translated_fields[field] | capitalize }} {{ form.errors.messages[field] }}</a>{% endif %}</li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}
      <div class="sf-form__row">
        <div class="sf-field">
          <label class="sf-field__label" for="RegisterForm-first_name">{{ 'customer.register.first_name' | t }}</label>
          <input class="sf-input" type="text" id="RegisterForm-first_name" name="customer[first_name]" value="{{ form.first_name | escape }}" autocomplete="given-name">
        </div>
        <div class="sf-field">
          <label class="sf-field__label" for="RegisterForm-last_name">{{ 'customer.register.last_name' | t }}</label>
          <input class="sf-input" type="text" id="RegisterForm-last_name" name="customer[last_name]" value="{{ form.last_name | escape }}" autocomplete="family-name">
        </div>
      </div>
      <div class="sf-field">
        <label class="sf-field__label" for="RegisterForm-email">{{ 'customer.register.email' | t }}</label>
        <input class="sf-input" type="email" id="RegisterForm-email" name="customer[email]" value="{{ form.email | escape }}" autocomplete="email" autocapitalize="off" spellcheck="false" required aria-required="true"{% if form.errors contains 'email' %} aria-invalid="true" aria-describedby="RegisterForm-email-error"{% endif %}>
        {%- if form.errors contains 'email' -%}<p class="sf-field__error" id="RegisterForm-email-error">{%- render 'sf-icon', name: 'error', size: 16 -%}<span>{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</span></p>{%- endif -%}
      </div>
      <div class="sf-field">
        <label class="sf-field__label" for="RegisterForm-password">{{ 'customer.register.password' | t }}</label>
        <input class="sf-input" type="password" id="RegisterForm-password" name="customer[password]" autocomplete="new-password" required aria-required="true"{% if form.errors contains 'password' %} aria-invalid="true" aria-describedby="RegisterForm-password-error"{% endif %}>
        {%- if form.errors contains 'password' -%}<p class="sf-field__error" id="RegisterForm-password-error">{%- render 'sf-icon', name: 'error', size: 16 -%}<span>{{ form.errors.translated_fields.password | capitalize }} {{ form.errors.messages.password }}</span></p>{%- endif -%}
      </div>
      <div class="sf-form__actions">
        <button type="submit" class="sf-btn sf-btn--primary sf-btn--full"><span class="sf-btn__label">{{ 'customer.register.submit' | t }}</span></button>
      </div>
    {%- endform -%}
    <div class="sf-customer__alt">
      <p class="sf-customer__alt-label">{{ 'customer.register.have_account' | t }}</p>
      <a class="sf-btn sf-btn--secondary sf-btn--full" href="{{ routes.account_login_url }}"><span class="sf-btn__label">{{ 'customer.register.login' | t }}</span></a>
    </div>
  </div>
</section>

{% schema %}
{ "name": "Create account", "class": "sf-shopify-section--main-register" }
{% endschema %}
